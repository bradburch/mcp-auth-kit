{
  "name": "mcp-server-kit",
  "version": "0.0.0",
  "description": "Production-ready MCP server kit: OAuth/PKCE, rate limiting, scope-gated tools, and two-phase confirm — bring your own tools, identity, and storage.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1",
    "hono": ">=4",
    "zod": "^3.25 || ^4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1",
    "@types/node": "^24",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "hono": "^4",
    "prettier": "^3.8.4",
    "typescript": "^6",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4",
    "zod": "^4"
  }
}
